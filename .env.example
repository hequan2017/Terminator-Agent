# ===== 安全 =====
# 用于会话签名和 SSH 私钥加密。务必设置为足够长的随机串并妥善备份：
# 变更后已保存的私钥将无法解密。可用：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 不设置时会自动生成并保存到 data/secret.key
SECRET_KEY=

# 管理员账号；不设置密码时首次启动会生成随机密码并打印在控制台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== 大模型（任意 OpenAI 兼容接口）=====
# OpenAI:      https://api.openai.com/v1                     gpt-4o
# DeepSeek:    https://api.deepseek.com/v1                   deepseek-chat
# 智谱 GLM:    https://open.bigmodel.cn/api/paas/v4          glm-4-plus
# 通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-max
# Ollama 本地: http://127.0.0.1:11434/v1                     qwen2.5:14b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ===== 运行参数 =====
# 单轮对话最多工具调用次数
AGENT_MAX_STEPS=25
# 单条命令默认超时（秒）
COMMAND_TIMEOUT=60
# 发版脚本单台主机超时（秒）
DEPLOY_TIMEOUT=900
# 是否校验 SSH known_hosts（生产环境建议 true）
SSH_STRICT_HOST_KEY=false
# 数据库路径
# DB_PATH=./data/terminator.db
